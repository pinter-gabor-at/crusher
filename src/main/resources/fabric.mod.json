{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "Crusher and Compressor",
  "description": "Crush anything that is crushable and then compress them to make new things.",
  "authors": [
    "Pintér Gábor <pinter.gabor@gmx.at>"
  ],
  "contact": {
    "homepage": "https://pintergabor.eu/en/minecraft/mods/${mod_id}/",
    "sources": "https://gitlab.com/pintergabor/${mod_id}"
  },
  "license": "MIT",
  "icon": "eu.pintergabor.crusher.icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "eu.pintergabor.crusher.Mod"
    ],
    "client": [
      "eu.pintergabor.crusher.ModClient"
    ],
    "fabric-datagen": [
      "eu.pintergabor.crusher.ModDataGenerator"
    ],
    "rei_common": [
      "eu.pintergabor.crusher.rei.ModReiCommon"
    ],
    "rei_client": [
      "eu.pintergabor.crusher.rei.ModReiClient"
    ]
  },
  "accessWidener": "eu.pintergabor.crusher.classtweaker",
  "depends": {
    "java": ">=25",
    "minecraft": "${minecraft_version_range}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}"
  },
  "recommends": {
    "rei": ">=${rei_version}"
  }
}
